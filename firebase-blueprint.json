{
  "entities": {
    "NewsItem": {
      "title": "NewsItem",
      "description": "Zelda news item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "galleryImages": { "type": "array" },
        "seoTitle": { "type": "string" },
        "metaDescription": { "type": "string" },
        "focusKeywords": { "type": "array" },
        "canonicalUrl": { "type": "string" },
        "jsonLdSchema": { "type": "string" },
        "authorByline": { "type": "string" },
        "eeatScore": { "type": "number" },
        "eeatDetails": { "type": "object" },
        "rssReferenceUrl": { "type": "string" },
        "rssSourceTitle": { "type": "string" },
        "rssPublishDate": { "type": "string" },
        "likes": { "type": "integer" }
      },
      "required": ["id", "title", "summary", "content", "date", "category", "imageUrl"]
    },
    "LoreEntry": {
      "title": "LoreEntry",
      "description": "Zelda lore entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "game": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["id", "title", "game", "category", "description", "imageUrl"]
    },
    "UserSubmission": {
      "title": "UserSubmission",
      "description": "User creations submitted to the club",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "author": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "contentUrl": { "type": "string" },
        "contentBody": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string" },
        "tokenized": { "type": "boolean" },
        "tokenDetails": { "type": "object" },
        "likes": { "type": "integer" }
      },
      "required": ["id", "author", "title", "type", "description", "date", "tokenized", "likes"]
    },
    "SidebarBlock": {
      "title": "SidebarBlock",
      "description": "Extra stuff sidebar content blocks managed by admins",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "content": { "type": "string" },
        "linkUrl": { "type": "string" },
        "order": { "type": "integer" }
      },
      "required": ["id", "title", "type", "content", "order"]
    }
  },
  "firestore": {
    "news": {
      "schema": "NewsItem",
      "description": "Latest Zelda news items"
    },
    "lore": {
      "schema": "LoreEntry",
      "description": "Zelda lore database entries"
    },
    "submissions": {
      "schema": "UserSubmission",
      "description": "Royal fan submissions"
    },
    "sidebarBlocks": {
      "schema": "SidebarBlock",
      "description": "Extra content blocks for the sidebar"
    }
  }
}
